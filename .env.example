# Copy this file to .env and fill in your key.
#   cp .env.example .env

# Required to actually transcribe. Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional. Speech-to-text model (source of truth for wording).
# Do not use gpt-4o-transcribe-diarize; it rewrites speech.
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# Optional. Text model that only assigns OPERATOR/CALLER labels.
OPENAI_SPEAKER_MODEL=gpt-4o-mini

# Optional. ISO-639-1 code such as en. Leave blank to let the API detect the language.
# OPENAI_TRANSCRIBE_LANGUAGE=en
